{
    // GitHub Codespaces: "Code → Codespaces → Create codespace" opens a
    // trial copy of the site in the browser, nothing to install locally.
    "name": "Fair Value",
    "image": "mcr.microsoft.com/devcontainers/php:3-8.3-bookworm",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Fair Value",
            "onAutoForward": "openBrowser"
        }
    },
    // Installs dependencies and creates the database with the first administrator.
    "postCreateCommand": "bash .devcontainer/setup.sh",
    // Runs the web server in a terminal of the editor, so it keeps running
    // and its log is visible.
    "postAttachCommand": "bash .devcontainer/serve.sh",
    "customizations": {
        "codespaces": {
            "openFiles": ["README.md"]
        }
    }
}
