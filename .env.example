APP_NAME="Fair Value"
APP_ENV=local
APP_KEY=
# true shows error details to visitors: only on your own computer, never on a public site.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent

# Behind Cloudflare or another proxy: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# Shows the demo login on the sign-in page. Keep false on the real site.
DEMO_MODE=false

# oz = O‘zbekcha (kirill), uz = O‘zbekcha (lotin), ru = Русский
APP_LOCALE=oz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" keeps one log file per day (storage/logs) and deletes files older than LOG_DAILY_DAYS.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# true on a site served over https: the login cookie is never sent over plain http.
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@fairvalue.uz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# First administrator, created by "php artisan db:seed"
ADMIN_EMAIL=admin@fairvalue.uz
ADMIN_PASSWORD=

# New website requests and security alerts are sent to this Telegram chat (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange rates of past dates (valuation date, dates of offers) are downloaded from cbu.uz
# CBU_HISTORY=true

# How long the audit log is kept, in days (at least 30; default 3 years)
AUDIT_RETENTION_DAYS=1095

# Comparative approach: automatic search and reading of sale offers (Claude, console.anthropic.com).
# Only listing pages and the object's characteristics are sent for this.
ANTHROPIC_API_KEY=
# Reading scans of passports and cadastral extracts with the same key (sends those scans to Anthropic).
# AI_DOCUMENTS=true
# ANTHROPIC_MODEL=claude-opus-5-5
# Sites the offers are taken from (comma-separated).
# ANALOG_DOMAINS=olx.uz,uybor.uz,realt24.uz,domtut.uz
